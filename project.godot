; 1848 — milestone 1. Open in Godot 4.7.2 standard and press F6/F5.
config_version=5

[application]
config/name="1848"
run/main_scene="res://scenes/claim.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/description="One man, one river, one gravel bar. North Yuba, June 1848."

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[autoload]
Sack="*res://scripts/sack.gd"
GameState="*res://scripts/game_state.gd"
Trip="*res://scripts/trip.gd"
Settings="*res://scripts/settings.gd"

[input]

fish={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":70),Object(InputEventJoypadButton,"button_index":3)]}
interact={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":71),Object(InputEventJoypadButton,"button_index":2)]}
debug_sandbox={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194335)]}
pan={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":69),Object(InputEventMouseButton,"button_index":1),Object(InputEventJoypadButton,"button_index":0)]}
debug_density={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194334)]}
move_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65),Object(InputEventKey,"physical_keycode":4194319),Object(InputEventJoypadMotion,"axis":0,"axis_value":-1.0)]}
move_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68),Object(InputEventKey,"physical_keycode":4194321),Object(InputEventJoypadMotion,"axis":0,"axis_value":1.0)]}
move_forward={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":87),Object(InputEventKey,"physical_keycode":4194320),Object(InputEventJoypadMotion,"axis":1,"axis_value":-1.0)]}
move_back={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":83),Object(InputEventKey,"physical_keycode":4194322),Object(InputEventJoypadMotion,"axis":1,"axis_value":1.0)]}
look_left={"deadzone":0.18,"events":[Object(InputEventJoypadMotion,"axis":2,"axis_value":-1.0)]}
look_right={"deadzone":0.18,"events":[Object(InputEventJoypadMotion,"axis":2,"axis_value":1.0)]}
look_up={"deadzone":0.18,"events":[Object(InputEventJoypadMotion,"axis":3,"axis_value":-1.0)]}
look_down={"deadzone":0.18,"events":[Object(InputEventJoypadMotion,"axis":3,"axis_value":1.0)]}
crew={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":67),Object(InputEventJoypadButton,"button_index":9)]}
wait={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":84),Object(InputEventJoypadButton,"button_index":10)]}
pause={"deadzone":0.2,"events":[Object(InputEventJoypadButton,"button_index":6)]}
photo={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":80),Object(InputEventJoypadButton,"button_index":4)]}

[rendering]
renderer/rendering_method="forward_plus"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/use_taa=true
global_illumination/gi/use_half_resolution=true
environment/defaults/default_clear_color=Color(0.63,0.70,0.73,1)

[shader_globals]

rain_wetness={
"type": "float",
"value": 0.0
}

season={
"type": "float",
"value": 0.0
}

[importer_defaults]

texture={
"compress/high_quality": true,
"compress/mode": 2
}
